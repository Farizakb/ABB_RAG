# Required. The reviewer supplies their own key; a full eval run costs about ten cents.
OPENAI_API_KEY=sk-replace-me

# ---- Optional, defaults shown ---------------------------------------------

LLM_MODEL=gpt-5.6-luna
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Postgres credentials (container-internal only; nothing external connects
# with these).
POSTGRES_USER=abb
POSTGRES_PASSWORD=abb
POSTGRES_DB=abb

# Host ports. Change only on conflict with something else already listening.
DB_PORT=5432
WEB_PORT=8080
PGADMIN_PORT=5050
