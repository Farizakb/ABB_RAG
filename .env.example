# Required. The reviewer supplies their own key; a full eval run costs about ten cents.
OPENAI_API_KEY=sk-replace-me

# ---- Optional, defaults shown ---------------------------------------------

# Confirmed by the SPEC §2 gate item V-2 on day one.
LLM_MODEL=gpt-5.6-luna
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Postgres credentials (container-internal only; nothing external connects
# with these except pgAdmin, below).
POSTGRES_USER=abb
POSTGRES_PASSWORD=abb
POSTGRES_DB=abb

# Host ports. Change only on conflict with something else already listening.
DB_PORT=5432
WEB_PORT=8080
PGADMIN_PORT=5050

# pgAdmin (loopback-only, profile-gated: `make db-ui`). Replace before use.
# NOTE: pgAdmin's email validator rejects RFC 2606-reserved TLDs (.local,
# .test, .invalid, etc.) -- use a non-reserved placeholder domain like
# .internal instead.
PGADMIN_DEFAULT_EMAIL=admin@abb.internal
PGADMIN_DEFAULT_PASSWORD=change-me
